# ── Node Environment ──────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://anjal:anjal_dev_password@localhost:5432/anjalarivaan

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:anjal_redis_dev@localhost:6379

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ── HashiCorp Vault ───────────────────────────────────────────────────────────
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=anjal-vault-dev-root

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=anjal_minio
MINIO_SECRET_KEY=anjal_minio_dev_password
MINIO_BUCKET_ATTACHMENTS=anjal-attachments

# ── OpenSearch ────────────────────────────────────────────────────────────────
OPENSEARCH_URL=http://localhost:9200

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ── Identity Service ──────────────────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_ACCESS_TOKEN_TTL=900          # 15 minutes in seconds
JWT_REFRESH_TOKEN_TTL=604800      # 7 days in seconds
ENCRYPTION_KEY=<generate-32-byte-hex-key>
MFA_ENABLED=true                   # Set to "false" to disable MFA globally (dev convenience)

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=takshashilauniv.ac.in

# ── WhatsApp BSP ──────────────────────────────────────────────────────────────
BSP_PROVIDER=gupshup
BSP_API_KEY=
BSP_WHATSAPP_NUMBER=

# ── AI Orchestrator ───────────────────────────────────────────────────────────
VLLM_BASE_URL=http://localhost:8000
VLLM_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
EMBEDDING_MODEL=BAAI/bge-m3

# ── Service Ports ─────────────────────────────────────────────────────────────
PWA_PORT=3000
IDENTITY_SERVICE_PORT=4001
ACCOUNT_LINK_SERVICE_PORT=4002
MAIL_SYNC_SERVICE_PORT=4003
NOTIFICATION_ROUTER_PORT=4004
MEETING_SERVICE_PORT=4005
URGENT_NOTIFICATION_PORT=4006
AI_ORCHESTRATOR_PORT=8080

# ── Docker Compose ────────────────────────────────────────────────────────────
# Uncomment to auto-load both compose files with `docker compose up`
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
