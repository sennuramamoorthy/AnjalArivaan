# =============================================================================
# AnjalArivaan — local dev environment variables
# Copy to `.env` and fill in real values (never commit the `.env` file).
# =============================================================================

# ---- App --------------------------------------------------------------------
APP_ENV=dev
APP_VERSION=1.0.0
LOG_LEVEL=INFO
DEBUG=false

# ---- Security (MUST regenerate for prod) ------------------------------------
# Generate with:   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-change-me-in-prod-very-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- MFA (TOTP) -------------------------------------------------------------
# Global kill-switch for multi-factor auth.
#   true  → MFA setup/verify endpoints are active; users with mfa_enabled=True
#           must present a TOTP code at login.
#   false → MFA is bypassed everywhere (setup/verify return 503, login ignores
#           any per-user mfa_enabled flag). Use only in dev/staging.
MFA_ENABLED=true
MFA_ISSUER=AnjalArivaan-Takshashila

# ---- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://anjal:anjal@localhost:5432/anjalarivaan
DATABASE_ECHO=false

# ---- Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- MinIO (S3) -------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_ATTACHMENTS=attachments
MINIO_SECURE=false

# ---- Google Workspace (fill in for real OAuth) ------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/accounts/oauth/callback
GOOGLE_WORKSPACE_ALLOWED_DOMAIN=takshashilauniv.ac.in
GOOGLE_PUBSUB_TOPIC=projects/takshashila/topics/gmail-push

# ---- WhatsApp BSP -----------------------------------------------------------
# Provider: gupshup | interakt | karix | twilio | stub
WHATSAPP_BSP=stub
WHATSAPP_API_BASE=
WHATSAPP_API_KEY=

# ---- AI / LLM ---------------------------------------------------------------
# Provider: vllm | ollama | stub
LLM_PROVIDER=stub
LLM_BASE_URL=http://localhost:8080
LLM_MODEL=mistral-small-3
LLM_MAX_TOKENS=1024

# ---- Vector store / Search --------------------------------------------------
QDRANT_URL=http://localhost:6333
OPENSEARCH_URL=http://localhost:9200
EMBEDDING_MODEL=BAAI/bge-m3

# ---- Vault ------------------------------------------------------------------
# Provider: hashicorp | stub
VAULT_PROVIDER=stub
VAULT_URL=http://localhost:8200
VAULT_TOKEN=
VAULT_MOUNT_POINT=secret

# ---- CORS -------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","https://anjalarivaan.takshashilauniv.ac.in"]

# ---- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
