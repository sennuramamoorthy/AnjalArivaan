# Frontend env.
# Public vars are exposed to the browser (must be prefixed NEXT_PUBLIC_).

# Where the browser talks to the backend. Usually a relative path because
# next.config.js already rewrites /api/v1/* to the internal backend URL.
NEXT_PUBLIC_API_BASE=/api/v1

# Where the Next server (inside docker) reaches the backend.
BACKEND_INTERNAL_URL=http://backend:8000
